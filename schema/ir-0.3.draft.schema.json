{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lsgoodlionel/NCSC/schema/ir-0.3.draft.schema.json",
  "title": "NCSC IR 0.3 草案（结构层）",
  "description": "草案，待 P-6 评审。在 0.2 基础上增加时间区间 valid_during；其余与 0.2 相同。区间起止先后、日历有效性由内核检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "concepts",
    "assertions"
  ],
  "properties": {
    "version": {
      "const": "0.3"
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "opaqueBody": {
      "description": "P-2：ID 前缀之后的不透明部分。内核不得解析、排序或比较其内部结构。",
      "type": "string",
      "pattern": "^[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^c:[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "relationId": {
      "type": "string",
      "pattern": "^r:[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "assertionId": {
      "type": "string",
      "pattern": "^a:[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src:[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "contextId": {
      "type": "string",
      "pattern": "^ctx:[0-9a-z](?:[0-9a-z._:-]{0,126}[0-9a-z])?$",
      "$ref": "#/$defs/singleLine"
    },
    "trimmedText": {
      "description": "非空、单行、首尾无空白；内部空格允许。",
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$",
      "$ref": "#/$defs/singleLine"
    },
    "kind": {
      "description": "P-1：本体类别（单值）。角色由断言的边表达，不由 kind 表达；十类不进入 IR。",
      "enum": [
        "entity",
        "event",
        "state",
        "quality",
        "value",
        "relation"
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "kind"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/conceptId"
            },
            {
              "$ref": "#/$defs/relationId"
            }
          ]
        },
        "aliases": {
          "description": "P-7：概念内唯一、首尾无空白、至少一个含汉字；跨概念同名（多义）允许。",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trimmedText"
          },
          "contains": {
            "type": "string",
            "pattern": "[㐀-䶿一-鿿豈-﫿]"
          }
        },
        "kind": {
          "$ref": "#/$defs/kind"
        }
      },
      "if": {
        "properties": {
          "id": {
            "pattern": "^r:"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "relation"
          }
        }
      },
      "else": {
        "properties": {
          "kind": {
            "not": {
              "const": "relation"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "description": {
          "$ref": "#/$defs/trimmedText"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles",
        "polarity",
        "sources",
        "context"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/assertionId"
        },
        "roles": {
          "description": "P-1：relation 位只能是 r: 关系类型；subject/object 只能是 c: 概念（0.2 不支持以关系为论元的元陈述）。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "relation",
            "object"
          ],
          "properties": {
            "subject": {
              "$ref": "#/$defs/conceptId"
            },
            "relation": {
              "$ref": "#/$defs/relationId"
            },
            "object": {
              "$ref": "#/$defs/conceptId"
            }
          }
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "context": {
          "$ref": "#/$defs/contextId"
        },
        "valid_at": {
          "$ref": "#/$defs/day"
        },
        "valid_during": {
          "$ref": "#/$defs/interval"
        }
      },
      "not": {
        "required": [
          "valid_at",
          "valid_during"
        ]
      }
    },
    "singleLine": {
      "description": "单行：不得含任何换行类字符（与 Python str.splitlines 的行边界一致）。也用于堵住 Python 正则中 $ 可匹配末尾换行之前的差异。",
      "not": {
        "pattern": "[\n\r\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029]"
      }
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "$ref": "#/$defs/singleLine"
    },
    "interval": {
      "description": "P-6：闭区间，两端含当日。缺少 from 表示起点未给出，缺少 to 表示终点未给出；至少给出一端。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "from": {
          "$ref": "#/$defs/day"
        },
        "to": {
          "$ref": "#/$defs/day"
        }
      }
    }
  }
}
