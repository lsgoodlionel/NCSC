{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lsgoodlionel/NCSC/schema/ir-0.1.schema.json",
  "title": "NCSC IR 0.1（结构层）",
  "description": "只描述字段与类型。重复 ID、悬空引用、日历有效性、分区与推导语义由 Python 内核检查，见 schema/README.md。本 Schema 忠实描述 0.1；valid_at 必须是零填充 YYYY-MM-DD，与内核（#12 起）一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "concepts",
    "assertions"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "text": {
      "description": "非空字符串：至少含一个非空白字符（对应内核 _nonempty_string）。",
      "type": "string",
      "pattern": "\\S"
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "kind": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles",
        "polarity",
        "sources",
        "context"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "relation",
            "object"
          ],
          "properties": {
            "subject": {
              "$ref": "#/$defs/text"
            },
            "relation": {
              "$ref": "#/$defs/text"
            },
            "object": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "context": {
          "$ref": "#/$defs/text"
        },
        "valid_at": {
          "description": "单日，零填充 YYYY-MM-DD。日历有效性（如 02-30）由内核检查。",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "$ref": "#/$defs/singleLine"
        }
      }
    },
    "singleLine": {
      "description": "单行：不得含任何换行类字符（与 Python str.splitlines 的行边界一致）。也用于堵住 Python 正则中 $ 可匹配末尾换行之前的差异。",
      "not": {
        "pattern": "[\n\r\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029]"
      }
    }
  }
}
